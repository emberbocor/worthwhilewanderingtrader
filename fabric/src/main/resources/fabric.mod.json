{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Replaces the wandering trader's trades with rare and useful goods, and lets it buy leftover items from players. Every trade is set in the server config. Only needed on the server.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/worthwhilewanderingtrader",
    "sources": "https://github.com/emberbocor/worthwhilewanderingtrader",
    "issues": "https://github.com/emberbocor/worthwhilewanderingtrader/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.emberbocor.worthwhilewanderingtrader.WorthwhileWanderingTraderFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=17"
  }
}
